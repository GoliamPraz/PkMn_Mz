# Labirint Game - Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000

# Game Settings
GAME_TICK_RATE=60
MAX_PLAYERS=50

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30000
WS_PLAYER_TIMEOUT=60000

# Database (for future features)
# DATABASE_URL=postgresql://user:password@localhost/labirint

# Logging
LOG_LEVEL=info
